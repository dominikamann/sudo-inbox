#!/usr/bin/env bash
# sudo-inbox: let agents queue root work, approve it yourself.
# https://github.com/dominikamann/sudo-inbox · MIT License
set -euo pipefail

if [ -z "${BASH_VERSINFO[0]:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "sudo-inbox: bash 4 or newer is required" >&2
  exit 2
fi

VERSION="0.1.0"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sudo-inbox"
ENTRIES="$STATE/entries"
MAX_SCRIPT_BYTES=122880 # below Linux MAX_ARG_STRLEN (128 KiB)
LONG_SCRIPT_LINES=60
RULE_HEAVY="════════════════════════════════════════"
RULE_LIGHT="────────────────────────────────────────"
ROOT_LOG="/var/log/sudo-inbox.log"
SENTINEL="__SUDO_INBOX_STARTED__"

# Runs as root through one sudo call. Arguments:
# $1 log path, $2 user, $3 entry, $4 type, $5 sha256, $6 title,
# $7 payload, $8 working directory.
# The sentinel proves that sudo got past authentication.
# shellcheck disable=SC2016 # expanded by the root shell, not here
ROOT_WRAPPER='
log() {
  printf "%s user=%s entry=%s type=%s sha256=%s exit=%s title=%s\n" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" "$4" "$5" "$6" "$1" "$7" >>"$LOG"
}
LOG="$1"
trap '"'"'log interrupted "$@"; exit 130'"'"' HUP INT TERM
echo "'"$SENTINEL"'"
if ! cd -- "$8"; then
  log 1 "$@"
  exit 1
fi
bash -c "$7" "sudo-inbox-$3"
rc=$?
log "$rc" "$@"
exit "$rc"
'

# Risky patterns (extended regex) and their labels, checked line by line.
RISK_PATTERNS=(
  'rm[[:space:]]+-[a-zA-Z]*[rR][a-zA-Z]*f|rm[[:space:]]+-[a-zA-Z]*f[a-zA-Z]*[rR]'
  '(^|[[:space:]>])/etc/'
  '/boot/'
  '(curl|wget)[^|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z)?sh'
  'chmod[[:space:]]+(-R[[:space:]]+)?0?777'
  'sudoers'
  'sshd_config|authorized_keys'
  'systemctl[[:space:]]+(start|stop|restart|enable|disable|mask)'
  'mkfs|dd[[:space:]]+if=|>[[:space:]]*/dev/sd'
  "(^|[[:space:]=<>\"'])(\\./|\\.\\./|~/|\\\$HOME|\\\$\\{HOME\\})"
  $'\xe2\x80\xaa|\xe2\x80\xab|\xe2\x80\xac|\xe2\x80\xad|\xe2\x80\xae|\xe2\x81\xa6|\xe2\x81\xa7|\xe2\x81\xa8|\xe2\x81\xa9'
)
RISK_LABELS=(
  'recursive force delete'
  'writes or touches /etc'
  'touches /boot'
  'pipes download into a shell'
  'world-writable permissions'
  'sudo configuration'
  'SSH access'
  'changes a service'
  'writes to a disk'
  'uses a file the agent can change'
  'hidden text direction (bidi)'
)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  local code="$1"
  shift
  printf 'sudo-inbox: %s\n' "$*" >&2
  exit "$code"
}

usage() {
  cat <<'EOF'
Usage: sudo-inbox <command> [args]

For agents:
  add <title> [--reason <text>] [-f <file>]
              Queue a script (stdin or -f).
  add-secret <NAME> --env <path> [options]
              Ask the user to set a secret.
  wait <n> [--timeout 20m]
              Block until entry n is handled.
  result <n>  Print status and output of n.

For you:
  list        Show waiting and recent entries.
  show <n>    Show entry n in full.
  run [<n>]   Review and run n (default: oldest).
  reject <n> [<reason>]
              Decline entry n.
  secret <NAME> --env <path> [options]
              Set a secret in a .env file.

Setup:
  hook claude-code
              Claude Code PreToolUse hook.
  install-hook claude-code
              Install that hook.
  help, version
EOF
}

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

log_user() {
  mkdir -p "$STATE"
  printf '%s %s\n' "$(now_utc)" "$*" >>"$STATE/log"
}

# Print stdin with control characters in caret notation (ESC -> ^[), and
# C1 controls and bidi overrides as <U+XXXX>, so nothing can move the
# cursor or hide text on the terminal. Newline and tab are kept, unless
# the first argument is "line", which also shows them as ^J and ^I.
sanitize() {
  local LC_ALL=C text i ch caret hex
  IFS= read -r -d '' text || true
  for ((i = 1; i < 32; i++)); do
    if [ "${1:-}" != line ] && { [ "$i" -eq 9 ] || [ "$i" -eq 10 ]; }; then continue; fi
    printf -v ch '%b' "\\$(printf '%03o' "$i")"
    printf -v caret '^%b' "\\$(printf '%03o' $((i + 64)))"
    text="${text//"$ch"/"$caret"}"
  done
  text="${text//$'\177'/^?}"
  for ((i = 0x80; i <= 0x9f; i++)); do
    printf -v ch '%b' "\\xc2\\x$(printf '%02x' "$i")"
    printf -v hex '<U+%04X>' "$i"
    text="${text//"$ch"/"$hex"}"
  done
  for hex in aa:202A ab:202B ac:202C ad:202D ae:202E; do
    printf -v ch '%b' "\\xe2\\x80\\x${hex%%:*}"
    text="${text//"$ch"/<U+${hex#*:}>}"
  done
  for hex in a6:2066 a7:2067 a8:2068 a9:2069; do
    printf -v ch '%b' "\\xe2\\x81\\x${hex%%:*}"
    text="${text//"$ch"/<U+${hex#*:}>}"
  done
  printf '%s' "$text"
}

# One field from disk, safe to print on a single line.
field() { entry_get "$1" "$2" | sanitize line; }

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

entry_dir() { printf '%s/%s' "$ENTRIES" "$1"; }

entry_get() {
  local f
  f="$(entry_dir "$1")/$2"
  [ -f "$f" ] && cat "$f"
  return 0
}

entry_set() { printf '%s' "$3" >"$(entry_dir "$1")/$2"; }

require_entry() {
  [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || die 2 "not an entry number: ${1:-}"
  [ -d "$(entry_dir "$1")" ] || die 5 "no entry #$1"
}

# Entry numbers, newest first.
entry_numbers() {
  [ -d "$ENTRIES" ] || return 0
  local d
  for d in "$ENTRIES"/*; do
    d="${d##*/}"
    [[ "$d" =~ ^[1-9][0-9]*$ ]] && printf '%s\n' "$d"
  done | sort -rn
}

# Create the next entry directory atomically and print its number.
new_entry() {
  mkdir -p "$ENTRIES"
  local n
  while :; do
    n="$(entry_numbers | head -n 1)"
    n=$((${n:-0} + 1))
    if mkdir "$(entry_dir "$n")" 2>/dev/null; then
      entry_set "$n" type "$1"
      entry_set "$n" status pending
      entry_set "$n" created "$(now_utc)"
      printf '%s' "$n"
      return 0
    fi
  done
}

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

risk_lines() {
  local line n=0 i
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    for i in "${!RISK_PATTERNS[@]}"; do
      if [[ "$line" =~ ${RISK_PATTERNS[$i]} ]]; then
        printf '%s: %s\n' "$n" "${RISK_LABELS[$i]}"
      fi
    done
  done
}

count_lines() {
  local content="$1" nl
  [ -z "$content" ] && { echo 0; return; }
  nl="${content//[!$'\n']/}"
  if [ "${content: -1}" = $'\n' ]; then echo "${#nl}"; else echo $((${#nl} + 1)); fi
}

sha256_of() { printf '%s' "$1" | sha256sum | cut -d ' ' -f 1; }

render_header() {
  local n="$1"
  printf '%s\n' "$RULE_HEAVY"
  printf '#%s  %s  %s  %s\n' "$n" "$(field "$n" status)" \
    "$(field "$n" type)" "$(field "$n" created)"
  printf 'Title (from agent): %s\n' "$(field "$n" title)"
  local reason
  reason="$(field "$n" reason)"
  printf 'Reason (from agent): %s\n' "${reason:--}"
}

# render_entry <n> [<content>]: full display of an entry. With <content>,
# that text is rendered instead of the stored script.
render_entry() {
  local n="$1" content risks lines line i=0
  if [ "$#" -ge 2 ]; then
    content="$2"
  else
    IFS= read -r -d '' content <"$(entry_dir "$n")/script" || true
  fi
  render_header "$n"
  printf 'Runs in: %s\n' "$(field "$n" cwd)"
  printf '%s\n' "$RULE_LIGHT"
  lines="$(count_lines "$content")"
  echo "Checks by sudo-inbox:"
  printf '  %s lines · sha256 %s…\n' "$lines" "$(sha256_of "$content" | cut -c 1-8)"
  if [ "$lines" -gt "$LONG_SCRIPT_LINES" ]; then
    printf '  ! long script (%s lines): read carefully\n' "$lines"
  fi
  risks="$(printf '%s' "$content" | risk_lines)"
  if [ -n "$risks" ]; then
    while IFS= read -r line; do printf '  ! line %s\n' "$line"; done <<<"$risks"
  else
    echo "  no risky patterns found"
  fi
  printf '%s\n' "$RULE_LIGHT"
  while IFS= read -r line || [ -n "$line" ]; do
    i=$((i + 1))
    printf '%3d│%s\n' "$i" "$(printf '%s' "$line" | sanitize)"
  done < <(printf '%s' "$content")
  printf '%s\n' "$RULE_HEAVY"
}

# notify <n> <title>: run the user's notification command in the
# background with $1 = number and $2 = title. Failures are ignored and
# never delay the agent.
notify() {
  local cmd="${SUDO_INBOX_NOTIFY:-}" cfg line
  cfg="${XDG_CONFIG_HOME:-$HOME/.config}/sudo-inbox/config"
  if [ -z "$cmd" ] && [ -f "$cfg" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" == NOTIFY=* ]] && cmd="${line#NOTIFY=}"
    done <"$cfg"
  fi
  [ -n "$cmd" ] || return 0
  (timeout 10 sh -c "$cmd" sudo-inbox-notify "$1" "$2" </dev/null >/dev/null 2>&1 &)
  return 0
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_add() {
  local title="" reason="" file="" have_title=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --reason) [ "$#" -ge 2 ] || die 2 "--reason needs a value"; reason="$2"; shift 2 ;;
      -f) [ "$#" -ge 2 ] || die 2 "-f needs a file"; file="$2"; shift 2 ;;
      -*) die 2 "unknown option for add: $1" ;;
      *) [ "$have_title" -eq 0 ] || die 2 "add takes one title"; title="$1"; have_title=1; shift ;;
    esac
  done
  [ -n "$title" ] || die 2 "add needs a title"

  mkdir -p "$STATE"
  local tmp size
  tmp="$(mktemp "$STATE/.add.XXXXXX")"
  if [ -n "$file" ]; then
    [ -f "$file" ] || { rm -f "$tmp"; die 2 "no such file: $file"; }
    cat -- "$file" >"$tmp"
  else
    cat >"$tmp"
  fi
  size="$(wc -c <"$tmp")"
  if [ "$size" -eq 0 ]; then rm -f "$tmp"; die 5 "script is empty"; fi
  if [ "$size" -gt "$MAX_SCRIPT_BYTES" ]; then rm -f "$tmp"; die 5 "script too large (max 120 KiB)"; fi
  if [ "$(tr -d '\000' <"$tmp" | wc -c)" -ne "$size" ]; then
    rm -f "$tmp"
    die 5 "script contains NUL bytes"
  fi

  local n
  n="$(new_entry script)"
  mv "$tmp" "$(entry_dir "$n")/script"
  entry_set "$n" title "$title"
  entry_set "$n" reason "$reason"
  entry_set "$n" cwd "$PWD"
  log_user "added #$n $title"
  notify "$n" "$title"
  echo "Entry #$n is waiting. Ask the user to run: sudo-inbox run $n"
}

cmd_list() {
  local n status shown=0 others=0 title
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    status="$(entry_get "$n" status)"
    if [ "$status" != pending ]; then
      others=$((others + 1))
      [ "$others" -le 10 ] || continue
    fi
    title="$(field "$n" title)"
    printf '#%s  %s  %s\n' "$n" "$(printf '%s' "$status" | sanitize line)" "${title:0:40}"
    shown=1
  done < <(entry_numbers)
  [ "$shown" -eq 1 ] || echo "Inbox is empty."
}

cmd_show() {
  [ "$#" -eq 1 ] || die 2 "usage: sudo-inbox show <n>"
  require_entry "$1"
  if [ "$(entry_get "$1" type)" = secret ]; then
    render_secret "$1"
  else
    render_entry "$1"
  fi
}

oldest_pending() {
  local n
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if [ "$(entry_get "$n" status)" = pending ]; then
      printf '%s' "$n"
      return 0
    fi
  done < <(entry_numbers | sort -n)
}

confirm() {
  local answer=""
  printf 'Run it? [y/N] '
  IFS= read -r answer || true
  case "$answer" in
    y | Y | yes) return 0 ;;
    *) return 1 ;;
  esac
}

# Show root output live, without the sentinel and with control
# characters made visible. The raw bytes still go to the agent.
show_live() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    [ "$line" = "$SENTINEL" ] && continue
    printf '%s\n' "$(printf '%s' "$line" | sanitize)"
  done
}

# root_exec <n> <type> <sha> <title> <payload> <cwd>
# Runs <payload> as root in one sudo call, with sudo -k before and after.
# Output is shown live and kept in ROOT_OUTPUT (without the sentinel).
# Returns the payload's exit code. ROOT_STARTED is 0 if sudo never started it.
ROOT_OUTPUT=""
ROOT_STARTED=0
RUN_TMP=""
root_exec() {
  local n="$1" type="$2" sha="$3" title="$4" payload="$5" cwd="$6" raw rc
  mkdir -p "$STATE"
  RUN_TMP="$(mktemp "$STATE/.run.XXXXXX")"
  sudo -k 2>/dev/null || true
  set +e
  sudo -- bash -c "$ROOT_WRAPPER" sudo-inbox "$ROOT_LOG" "$(id -un)" "$n" "$type" "$sha" \
    "$(printf '%s' "$title" | sanitize line)" "$payload" "$cwd" 2>&1 \
    | tee "$RUN_TMP" | show_live
  rc="${PIPESTATUS[0]}"
  set -e
  sudo -k 2>/dev/null || true
  IFS= read -r -d '' raw <"$RUN_TMP" || true
  rm -f "$RUN_TMP"
  RUN_TMP=""
  if [[ "$raw" != *"$SENTINEL"$'\n'* ]]; then
    ROOT_OUTPUT=""
    ROOT_STARTED=0
    return 6
  fi
  ROOT_STARTED=1
  ROOT_OUTPUT="${raw#*"$SENTINEL"$'\n'}"
  return "$rc"
}

# Hangup or Ctrl-C while root code runs: the script may have run partly.
RUN_ENTRY=""
on_interrupt() {
  trap - HUP INT TERM
  sudo -k 2>/dev/null || true
  [ -z "$RUN_TMP" ] || rm -f "$RUN_TMP"
  if [ -n "$RUN_ENTRY" ]; then
    entry_set "$RUN_ENTRY" status interrupted
    entry_set "$RUN_ENTRY" finished "$(now_utc)"
    log_user "interrupted #$RUN_ENTRY"
  fi
  exit 130
}

cmd_run() {
  [ "$#" -le 1 ] || die 2 "usage: sudo-inbox run [<n>]"
  local n="${1:-}" status content sha title cwd rc=0
  if [ -z "$n" ]; then
    n="$(oldest_pending)"
    if [ -z "$n" ]; then
      echo "Inbox is empty."
      return 0
    fi
  fi
  require_entry "$n"
  status="$(entry_get "$n" status)"
  if [ "$status" = interrupted ] || [ "$status" = running ]; then
    die 5 "entry #$n is $status: it may have run partly.
Check the system, then reject it or queue it again."
  fi
  [ "$status" = pending ] || die 5 "entry #$n is $(printf '%s' "$status" | sanitize line)"
  if [ "$(entry_get "$n" type)" = secret ]; then
    run_secret "$n"
    return 0
  fi

  IFS= read -r -d '' content <"$(entry_dir "$n")/script" || true
  title="$(entry_get "$n" title)"
  cwd="$(entry_get "$n" cwd)"
  sha="$(sha256_of "$content")"
  render_entry "$n" "$content"
  if ! confirm; then
    echo "Not run. Entry #$n stays pending."
    return 0
  fi

  entry_set "$n" status running
  RUN_ENTRY="$n"
  trap on_interrupt HUP INT TERM
  root_exec "$n" script "$sha" "$title" "$content" "${cwd:-/}" || rc=$?
  trap - HUP INT TERM
  if [ "$ROOT_STARTED" -eq 0 ]; then
    entry_set "$n" status pending
    die 6 "sudo authentication failed. Entry #$n stays pending.
Run it in a terminal (e.g. a second SSH tab): sudo-inbox run $n"
  fi
  printf '%s' "$ROOT_OUTPUT" >"$(entry_dir "$n")/output"
  entry_set "$n" exit_code "$rc"
  entry_set "$n" sha256 "$sha"
  entry_set "$n" finished "$(now_utc)"
  entry_set "$n" status "done"
  log_user "ran #$n exit=$rc"
  echo "Done. Exit code $rc. The agent can read it with: sudo-inbox result $n"
}

cmd_reject() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then die 2 "usage: sudo-inbox reject <n> [<reason>]"; fi
  require_entry "$1"
  local status
  status="$(entry_get "$1" status)"
  [ "$status" = pending ] || die 5 "entry #$1 is $status"
  entry_set "$1" reject_reason "${2:-}"
  entry_set "$1" finished "$(now_utc)"
  entry_set "$1" status rejected
  log_user "rejected #$1"
  echo "Entry #$1 rejected."
}

# print_result <n>: status block for agents. Exit code per status.
print_result() {
  local n="$1" status code
  status="$(entry_get "$n" status)"
  case "$status" in
    pending | running)
      echo "status: $status"
      return 0
      ;;
    interrupted)
      echo "status: interrupted (it may have run partly)"
      return 1
      ;;
    rejected)
      echo "status: rejected"
      printf 'reason: %s\n' "$(entry_get "$n" reject_reason)"
      return 3
      ;;
  esac
  code="$(entry_get "$n" exit_code)"
  printf 'status: %s\nexit_code: %s\n--- output ---\n' "$status" "$code"
  entry_get "$n" output
  [ "$code" = 0 ] && return 0
  return 1
}

cmd_result() {
  [ "$#" -eq 1 ] || die 2 "usage: sudo-inbox result <n>"
  require_entry "$1"
  print_result "$1"
}

# Parse <int>[s|m|h] into seconds.
parse_duration() {
  [[ "$1" =~ ^([0-9]+)([smh]?)$ ]] || return 1
  local v="${BASH_REMATCH[1]}"
  case "${BASH_REMATCH[2]}" in
    m) v=$((v * 60)) ;;
    h) v=$((v * 3600)) ;;
  esac
  printf '%s' "$v"
}

cmd_wait() {
  local n="" timeout="20m" secs deadline
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --timeout) [ "$#" -ge 2 ] || die 2 "--timeout needs a value"; timeout="$2"; shift 2 ;;
      *) [ -z "$n" ] || die 2 "usage: sudo-inbox wait <n> [--timeout 20m]"; n="$1"; shift ;;
    esac
  done
  require_entry "$n"
  secs="$(parse_duration "$timeout")" || die 2 "bad timeout: $timeout (use e.g. 90s, 20m, 1h)"
  deadline=$((SECONDS + secs))
  while [[ "$(entry_get "$n" status)" =~ ^(pending|running)$ ]]; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "status: pending (timed out after $timeout)"
      return 4
    fi
    sleep 2
  done
  print_result "$n"
}

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Runs as the user or as root with the arguments set in front of it:
# $1 file, $2 key, $3 mode, $4 owner (empty: keep), $5 invoking user,
# $6 expected real directory (root only). Reads the already quoted value
# from stdin, never from argv. Exit 5 means refused.
# shellcheck disable=SC2016 # expanded by the writer shell, not here
ENV_WRITER='
set -e
f="$1" key="$2" mode="$3" owner="$4" me="$5" realdir="$6"
dir="$(dirname -- "$f")"
fail() { echo "sudo-inbox: $1" >&2; exit "${2:-5}"; }
if [ -n "$realdir" ] && [ "$(realpath -e -- "$dir")" != "$realdir" ]; then
  fail "refused: $dir changed"
fi
[ ! -L "$f" ] || fail "refused: $f is a symlink"
[ ! -e "$f" ] || [ -f "$f" ] || fail "refused: $f is not a regular file"
IFS= read -r val
tmp="$(mktemp "$dir/.sudo-inbox-env.XXXXXX")" || fail "cannot write in $dir" 1
trap '"'"'rm -f "$tmp"'"'"' EXIT
if [ -e "$f" ]; then
  [ -r "$f" ] || fail "cannot read $f" 1
  [ -n "$owner" ] || owner="$(stat -c %U:%G -- "$f")"
  grep -v -E -e "^(export[[:space:]]+)?$key=" -- "$f" >"$tmp" \
    || [ "$?" -le 1 ] || fail "cannot read $f" 1
fi
[ -n "$owner" ] || owner="$me"
printf "%s=%s\n" "$key" "$val" >>"$tmp"
chmod "$mode" "$tmp"
chown "$owner" "$tmp"
mv -f "$tmp" "$f"
trap - EXIT
'

S_NAME="" S_ENV="" S_MIN=1 S_MAX=4096 S_OWNER="" S_MODE=600
parse_secret_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --env | --min | --max | --owner | --mode)
        [ "$#" -ge 2 ] || die 2 "$1 needs a value"
        case "$1" in
          --env) S_ENV="$2" ;;
          --min) S_MIN="$2" ;;
          --max) S_MAX="$2" ;;
          --owner) S_OWNER="$2" ;;
          --mode) S_MODE="$2" ;;
        esac
        shift 2
        ;;
      -*) die 2 "unknown option: $1" ;;
      *) [ -z "$S_NAME" ] || die 2 "only one NAME allowed"; S_NAME="$1"; shift ;;
    esac
  done
  [[ "$S_NAME" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die 2 "NAME must look like MY_SECRET"
  [ -n "$S_ENV" ] || die 2 "--env <path> is required"
  [[ "$S_MIN" =~ ^[0-9]+$ && "$S_MAX" =~ ^[0-9]+$ ]] || die 2 "--min/--max need numbers"
  [[ "$S_MODE" =~ ^[0-7]{3,4}$ ]] || die 2 "--mode needs an octal mode like 600"
  valid_owner "$S_OWNER" || die 2 "--owner needs user or user:group"
  [[ "$S_ENV" == /* ]] || S_ENV="$PWD/$S_ENV"
}

valid_owner() { [ -z "$1" ] || [[ "$1" =~ ^[a-z_][a-z0-9_.-]*(:[a-z_][a-z0-9_.-]*)?$ ]]; }

# Validate secret parameters read back from disk (the agent can edit them).
validate_secret() {
  local name="$1" path="$2" min="$3" max="$4" owner="$5" mode="$6"
  [[ "$name" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die 5 "refused: invalid NAME in entry"
  [[ "$min" =~ ^[0-9]+$ && "$max" =~ ^[0-9]+$ ]] || die 5 "refused: invalid length limits"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die 5 "refused: invalid mode in entry"
  valid_owner "$owner" || die 5 "refused: invalid owner in entry"
  [[ "$path" == /* ]] || die 5 "refused: path must be absolute"
  check_env_path "$path"
}

# True if the user can write <dir> or any directory above it.
writable_ancestor() {
  local d="$1"
  while :; do
    [ -w "$d" ] && return 0
    [ "$d" = / ] && return 1
    d="$(dirname -- "$d")"
  done
}

check_env_path() {
  local p="$1" base="${1##*/}"
  [[ "$base" == .env || "$base" == .env.* || "$base" == *.env ]] \
    || die 5 "refused: only .env files are allowed ($p)"
  [ ! -L "$p" ] || die 5 "refused: $p is a symlink"
  [ ! -e "$p" ] || [ -f "$p" ] || die 5 "refused: $p is not a regular file"
  [ -d "$(dirname "$p")" ] || die 5 "refused: directory of $p does not exist"
}

env_quote() {
  if [[ "$1" =~ ^[A-Za-z0-9_./:@%+=,-]*$ ]]; then
    printf '%s' "$1"
  else
    printf "'%s'" "$1"
  fi
}

# Ask for the value, validate it and write it. Sets SECRET_LEN.
SECRET_LEN=0
write_secret() {
  local name="$1" path="$2" min="$3" max="$4" owner="$5" mode="$6" v1="" v2="" payload rc=0
  printf 'Value for %s: ' "$name" >&2
  IFS= read -rs v1 || true
  printf '\nRepeat: ' >&2
  IFS= read -rs v2 || true
  printf '\n' >&2
  [ "$v1" = "$v2" ] || die 5 "Values do not match."
  if [ "${#v1}" -lt "$min" ] || [ "${#v1}" -gt "$max" ]; then
    die 5 "length ${#v1} is outside $min..$max"
  fi
  [[ "$v1" != *"'"* ]] || die 5 "refused: single quotes are not supported"
  local dir me
  dir="$(dirname -- "$path")"
  me="$(id -un):$(id -gn)"
  if [ -w "$dir" ]; then
    # You (and an agent running as you) control this directory anyway.
    if [ -n "$owner" ] && [ "${owner%%:*}" != "$(id -un)" ]; then
      die 5 "refused: $dir is writable by you, so owner $owner
cannot protect the file. Use a root-owned directory."
    fi
    payload="$(printf 'set -- %q %q %q %q %q ""\n' "$path" "$name" "$mode" "$owner" "$me")$ENV_WRITER"
    bash -c "$payload" sudo-inbox-secret < <(env_quote "$v1"; echo) || rc=$?
  elif writable_ancestor "$dir"; then
    die 5 "refused: a parent of $dir is writable by you,
so root cannot write there safely"
  else
    payload="$(printf 'set -- %q %q %q %q %q %q\n' "$path" "$name" "$mode" "$owner" "$me" \
      "$(realpath -e -- "$dir")")$ENV_WRITER"
    root_exec - secret - "Set $name in $path" "$payload" / < <(env_quote "$v1"; echo) || rc=$?
    [ "$ROOT_STARTED" -eq 1 ] || die 6 "sudo authentication failed. Nothing was written."
  fi
  [ "$rc" -ne 5 ] || die 5 "refused: nothing was written to $path"
  [ "$rc" -eq 0 ] || die 1 "could not write $path"
  SECRET_LEN="${#v1}"
}

cmd_secret() {
  parse_secret_args "$@"
  check_env_path "$S_ENV"
  write_secret "$S_NAME" "$S_ENV" "$S_MIN" "$S_MAX" "$S_OWNER" "$S_MODE"
  log_user "secret $S_NAME set in $S_ENV"
  echo "$S_NAME set in $S_ENV (length $SECRET_LEN)."
}

cmd_add_secret() {
  parse_secret_args "$@"
  check_env_path "$S_ENV"
  local n
  n="$(new_entry secret)"
  entry_set "$n" title "Set $S_NAME in $S_ENV"
  entry_set "$n" reason ""
  entry_set "$n" name "$S_NAME"
  entry_set "$n" env "$S_ENV"
  entry_set "$n" min "$S_MIN"
  entry_set "$n" max "$S_MAX"
  entry_set "$n" owner "$S_OWNER"
  entry_set "$n" mode "$S_MODE"
  log_user "added #$n secret $S_NAME"
  notify "$n" "Set $S_NAME in $S_ENV"
  echo "Entry #$n is waiting. Ask the user to run: sudo-inbox run $n"
}

render_secret() {
  local n="$1" owner
  owner="$(field "$n" owner)"
  render_header "$n"
  printf '%s\n' "$RULE_LIGHT"
  printf 'Set secret %s\n' "$(field "$n" name)"
  printf 'File: %s\n' "$(field "$n" env)"
  printf 'Mode: %s  Owner: %s\n' "$(field "$n" mode)" "${owner:-file owner or you}"
  printf '%s\n' "$RULE_HEAVY"
}

run_secret() {
  local n="$1" name path min max owner mode
  # Read every field once, validate, show and write exactly these values.
  name="$(entry_get "$n" name)"
  path="$(entry_get "$n" env)"
  min="$(entry_get "$n" min)"
  max="$(entry_get "$n" max)"
  owner="$(entry_get "$n" owner)"
  mode="$(entry_get "$n" mode)"
  validate_secret "$name" "$path" "$min" "$max" "$owner" "$mode"
  render_header "$n"
  printf '%s\n' "$RULE_LIGHT"
  printf 'Set secret %s\n' "$name"
  printf 'File: %s\n' "$(printf '%s' "$path" | sanitize line)"
  printf 'Mode: %s  Owner: %s\n' "$mode" "${owner:-file owner or you}"
  printf '%s\n' "$RULE_HEAVY"
  if ! confirm; then
    echo "Not run. Entry #$n stays pending."
    return 0
  fi
  check_env_path "$path"
  write_secret "$name" "$path" "$min" "$max" "$owner" "$mode"
  entry_set "$n" output "set, length $SECRET_LEN"
  entry_set "$n" exit_code 0
  entry_set "$n" finished "$(now_utc)"
  entry_set "$n" status "done"
  log_user "ran #$n secret"
  echo "Done. The agent sees only: set, length $SECRET_LEN"
}

# ---------------------------------------------------------------------------
# Hook
# ---------------------------------------------------------------------------

HOOK_MESSAGE='Blocked by sudo-inbox: this needs root.
Do not run sudo, su, doas or pkexec directly.
1. Put the commands in a small script with one purpose.
2. Queue it: sudo-inbox add "<title>" --reason "<why>" < script.sh
3. Ask the user to run this in their own terminal: sudo-inbox run <n>
4. Then read the result: sudo-inbox wait <n>
For passwords use: sudo-inbox add-secret <NAME> --env <path>'

# json_get_string <key>: first string value of "<key>" in the JSON on stdin.
json_get_string() {
  local LC_ALL=C json rest out="" c i=1
  IFS= read -r -d '' json || true
  rest="${json#*"\"$1\""}"
  [ "$rest" != "$json" ] || return 1
  rest="${rest#"${rest%%[![:space:]]*}"}"
  [ "${rest:0:1}" = ":" ] || return 1
  rest="${rest:1}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  [ "${rest:0:1}" = '"' ] || return 1
  while [ "$i" -lt "${#rest}" ]; do
    c="${rest:i:1}"
    if [ "$c" = "\\" ]; then
      i=$((i + 1))
      c="${rest:i:1}"
      case "$c" in
        n) out+=$'\n' ;;
        t) out+=$'\t' ;;
        r) out+=$'\r' ;;
        '"' | "\\" | /) out+="$c" ;;
        *) out+="\\$c" ;;
      esac
    elif [ "$c" = '"' ]; then
      printf '%s' "$out"
      return 0
    else
      out+="$c"
    fi
    i=$((i + 1))
  done
  return 1
}

# hook_check <command>: 0 if allowed, 1 if it runs a privileged command
# that would need a password.
hook_check() {
  local cmd="$1" seg sep i w base
  local -a words
  # shellcheck disable=SC2016 # literal separators
  for sep in '$(' '&&' '||' ';' '|' '&' '(' ')' '`'; do
    cmd="${cmd//"$sep"/$'\n'}"
  done
  while IFS= read -r seg; do
    read -ra words <<<"$seg"
    i=0
    while [ "$i" -lt "${#words[@]}" ]; do
      w="${words[$i]}"
      if [[ "$w" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
        i=$((i + 1))
        continue
      fi
      case "$w" in
        then | do | else | exec | env | nohup | time | xargs | nice | ionice) i=$((i + 1)); continue ;;
        timeout)
          i=$((i + 1))
          while [[ "${words[$i]:-}" == -* ]]; do i=$((i + 1)); done
          i=$((i + 1))
          continue
          ;;
      esac
      break
    done
    [ "$i" -lt "${#words[@]}" ] || continue
    base="${words[$i]##*/}"
    case "$base" in
      su | doas | pkexec) return 1 ;;
      sudo)
        case "${words[$((i + 1))]:-}" in
          -n | -l | -k | -K) continue ;;
        esac
        sudo -n -l "${words[@]:$((i + 1))}" >/dev/null 2>&1 || return 1
        ;;
    esac
  done <<<"$cmd"
  return 0
}

cmd_hook() {
  [ "${1:-}" = claude-code ] || die 2 "usage: sudo-inbox hook claude-code"
  local input tool command
  IFS= read -r -d '' input || true
  tool="$(json_get_string tool_name <<<"$input")" || return 0
  [ "$tool" = Bash ] || return 0
  command="$(json_get_string command <<<"$input")" || return 0
  if ! hook_check "$command"; then
    printf '%s\n' "$HOOK_MESSAGE" >&2
    exit 2
  fi
}

cmd_install_hook() {
  [ "${1:-}" = claude-code ] || die 2 "usage: sudo-inbox install-hook claude-code"
  local self settings snippet
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  settings="$HOME/.claude/settings.json"
  snippet="{
  \"hooks\": {
    \"PreToolUse\": [
      {
        \"matcher\": \"Bash\",
        \"hooks\": [
          { \"type\": \"command\", \"command\": \"$self hook claude-code\" }
        ]
      }
    ]
  }
}"
  if [ ! -e "$settings" ]; then
    mkdir -p "$(dirname "$settings")"
    printf '%s\n' "$snippet" >"$settings"
    echo "Hook installed in $settings."
    return 0
  fi
  if grep -q 'sudo-inbox hook claude-code' "$settings"; then
    echo "Hook already installed."
    return 0
  fi
  printf '%s\n' "$snippet"
  echo "Add this to \"hooks\" → \"PreToolUse\" in $settings."
  exit 5
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
  if [ "$#" -eq 0 ]; then
    usage
    exit 2
  fi
  local cmd="$1"
  shift
  case "$cmd" in
    help | -h | --help) usage ;;
    version | --version) echo "sudo-inbox $VERSION" ;;
    add) cmd_add "$@" ;;
    list) cmd_list "$@" ;;
    show) cmd_show "$@" ;;
    run) cmd_run "$@" ;;
    reject) cmd_reject "$@" ;;
    result) cmd_result "$@" ;;
    wait) cmd_wait "$@" ;;
    secret) cmd_secret "$@" ;;
    add-secret) cmd_add_secret "$@" ;;
    hook) cmd_hook "$@" ;;
    install-hook) cmd_install_hook "$@" ;;
    *) die 2 "unknown command: $cmd (see: sudo-inbox help)" ;;
  esac
}

main "$@"
